# Frontend build variables. On Netlify, set these under
# Site configuration → Environment variables before the build runs.
# Vite inlines them into the static bundle, so a change needs a new deploy.
# Leave the Supabase pair empty to run in demo mode (data stays in this browser).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to the literal true only after the email Edge Functions are deployed.
# Any other value keeps email calls off.
VITE_EMAIL_ENABLED=
